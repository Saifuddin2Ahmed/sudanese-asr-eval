  "fp16": true,
  "gradient_checkpointing": false,
  "spec_augment": false,
  "save_model": true,
  "split_tsv": "/kaggle/working/splits/sdn_split_v1.tsv",
  "cache_dir": "/tmp/cache",
  "out_dir": "/kaggle/working/outputs"
}
