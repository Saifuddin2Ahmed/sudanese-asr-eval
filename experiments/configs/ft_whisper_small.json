{
  "name": "ft_whisper_small",
  "base_model": "openai/whisper-small",
  "mode": "full",
  "seed": 42,
  "bootstrap": 1000,
  "lr": 1e-5,
  "weight_decay": 0.0,
  "warmup_steps": 300,
