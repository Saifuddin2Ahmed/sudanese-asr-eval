{
  "name": "lora_whisper_large_v3_turbo",
  "base_model": "openai/whisper-large-v3-turbo",
  "mode": "lora",
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_targets": ["q_proj", "k_proj", "v_proj", "out_proj", "fc1", "fc2"],
  "seed": 42,
  "bootstrap": 1000,
  "lr": 5e-4,
  "weight_decay": 0.0,
  "warmup_steps": 100,
  "max_steps": 2000,
  "batch_size": 8,
  "grad_accum": 2,
  "eval_every": 200,
  "patience": 4,
  "eval_batch_size": 16,
  "fp16": true,
  "gradient_checkpointing": true,
  "spec_augment": false,
  "save_model": true,
  "split_tsv": "/kaggle/working/splits/sdn_split_v1.tsv",
  "cache_dir": "/tmp/cache",
  "out_dir": "/kaggle/working/outputs"
}
